# ==============================================================================
# Trinetra Environment Configuration (.env.example)
# Copy this file to .env and supply actual values for your local environment.
# NEVER commit the real .env file with secrets to version control!
# ==============================================================================

# Database (PostgreSQL + pgvector)
POSTGRES_DB=trinetra_prod
POSTGRES_USER=trinetra_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
ConnectionStrings__TrinetraDb="Host=localhost;Port=5432;Database=trinetra_prod;Username=trinetra_user;Password=replace_with_strong_password"

# Redis Cache & Agent Stream Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ConnectionStrings__Redis="localhost:6379"

# Elasticsearch & Kibana (Structured Logging)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL="http://localhost:9200"
KIBANA_PORT=5601

# OpenTelemetry & Jaeger (Distributed Tracing)
JAEGER_UI_PORT=16686
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# Prometheus (Metrics)
PROMETHEUS_PORT=9090

# AI / Semantic Kernel Configuration
Ai__ModelId="claude-sonnet-4-5"
Ai__AnthropicApiKey="replace_with_anthropic_api_key"
Ai__EmbeddingModelId="text-embedding-3-small"

# Authentication & JWT
Jwt__Issuer="Trinetra.API"
Jwt__Audience="Trinetra.App"
Jwt__Key="replace_with_a_super_secret_key_at_least_32_characters_long"
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# Initial Admin Seed
Admin__Username="admin"
Admin__Email="admin@trinetra.local"
Admin__Password="replace_with_initial_admin_password"
Admin__Role="admin"
