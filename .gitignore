# --------------------------------------------------
# Trinetra Root .gitignore
# Covers: .NET, Python, Node/React, IDEs, OS, & AI Metadata
# --------------------------------------------------

# Build and Compilation Artifacts (.NET)
bin/
obj/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
packages/
*.nupkg
TestResults/
*.trx

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend (React/TypeScript)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
out/
.next/
.parcel-cache/
.cache/

# IDE & Editor Files
.vs/
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
secrets.json
appsettings.*.local.json

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# AI Assistant Metadata & Internal Scripts (Local Only)
GEMINI.md
AGENTS.md
CLAUDE.md
.agents/
.agent/
_agents/
scripts/
tools/push-to-github*
