{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TrinetraDb": "Host=localhost;Port=5432;Database=trinetra_prod;Username=trinetra_user;Password=replace_with_strong_password",
    "Redis": "localhost:6379"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  },
  "Ai": {
    "ModelId": "claude-sonnet-4-5",
    "AnthropicApiKey": "",
    "EmbeddingModelId": "text-embedding-3-small",
    "Agents": {
      "IncidentCoordinator": {
        "ModelId": "claude-sonnet-4-5",
        "Temperature": 0.3,
        "MaxTokens": 2000,
        "TimeoutSeconds": 300
      },
      "LogAnalyzer": {
        "ModelId": "claude-sonnet-4-5",
        "Temperature": 0.2,
        "MaxTokens": 3000,
        "TimeoutSeconds": 120
      },
      "MetricsQuerier": {
        "ModelId": "claude-sonnet-4-5",
        "Temperature": 0.2,
        "MaxTokens": 2500,
        "TimeoutSeconds": 120
      },
      "RunbookRetriever": {
        "ModelId": "claude-sonnet-4-5",
        "Temperature": 0.1,
        "MaxTokens": 2000,
        "TimeoutSeconds": 60
      },
      "RootCauseAnalyzer": {
        "ModelId": "claude-sonnet-4-5",
        "Temperature": 0.3,
        "MaxTokens": 3000,
        "TimeoutSeconds": 120
      },
      "RemediationProposer": {
        "ModelId": "claude-sonnet-4-5",
        "Temperature": 0.2,
        "MaxTokens": 3000,
        "TimeoutSeconds": 120
      },
      "AutoExecutor": {
        "ModelId": "claude-sonnet-4-5",
        "Temperature": 0.1,
        "MaxTokens": 2000,
        "TimeoutSeconds": 300
      },
      "ApprovalGate": {
        "ModelId": "claude-sonnet-4-5",
        "Temperature": 0.1,
        "MaxTokens": 1500,
        "TimeoutSeconds": 900
      }
    }
  },
  "Jwt": {
    "Issuer": "Trinetra.API",
    "Audience": "Trinetra.App",
    "Key": "default_trinetra_super_secret_development_key_minimum_32_chars!",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  }
}
