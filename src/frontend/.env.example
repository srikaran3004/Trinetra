# Trinetra Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to the repository.

# Backend API base URL (for Vite proxy target override)
VITE_API_BASE_URL=http://localhost:5000

# Enable MSW mock service worker in development
# Set to "false" to proxy directly to the real backend
VITE_MSW_ENABLED=true

# Dev banner text (shown when MSW is active)
VITE_DEV_BANNER=Demo data — MSW mock active
