# Trinetra Frontend Environment Configuration (.env.example)
# In development, Vite will use these defaults.

# Base REST API endpoint (per Doc 04)
VITE_API_BASE_URL=/v1

# Enable Mock Service Worker (MSW) in development (defaults to true)
VITE_MOCK_API=true

# SignalR Realtime Hub URL
VITE_SIGNALR_HUB_URL=/hubs/incidents
